<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head.ejs') %>
  </head>
  <body>
    <!-- Header -->
    <%- include('../partials/nav.ejs') %>
    <main class="min-h-[100vh]">
      <div class="w-full max-w-6xl m-5">
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 perspective-1000">
          <% if (registeredHomes && registeredHomes.length> 0) { %> <%
          registeredHomes.forEach(home=> { %>
          <li
            class="bg-white border border-gray-200 p-6 rounded-2xl shadow-lg transition duration-500 transform hover:-translate-y-2 hover:scale-105 hover:shadow-2xl"
          >
            <!-- Image -->
            <img
              src="<%= home.imgaeUrl %>"
              alt="<%= home.houseName %>"
              class="w-full h-48 object-cover rounded-xl mb-4"
            />

            <!-- Title -->
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
              <%= home.houseName %>
            </h2>

            <!-- Description -->
            <p class="text-gray-600 text-sm mb-4"><%= home.description %></p>

            <!-- Price -->
            <p class="text-lg font-semibold text-red-600 mb-4">
              ₹<%= home.price %>/night
            </p>

            <!-- Button -->
            <a
              href="/host/editHome/<%= home._id %>?editing=true"
              class="w-full inline-block text-center mb-3 px-4 py-2 bg-gradient-to-r from-sky-500 to-sky-600 text-white text-sm rounded-lg shadow-md hover:shadow-xl hover:from-sky-600 hover:to-sky-700 transition"
            >
              Edit
            </a>

            <form action="/host/deletHome/<%= home._id %>" method="POST">
              <button
                type="submit"
                class="w-full inline-block text-center px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white text-sm rounded-lg shadow-md hover:shadow-xl hover:from-red-600 hover:to-red-700 transition"
              >
                Delete
              </button>
            </form>
          </li>

          <% }) %> <% } else { %>
          <p class="text-gray-600 italic text-center">
            No homes registered yet.
          </p>
          <% } %>
        </ul>
      </div>
    </main>
    <%- include('../partials/footer.ejs') %>
  </body>
</html>
